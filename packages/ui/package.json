{
  "name": "@sean/ui",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js"
    },
    "./global": {
      "types": "./dist/global-install.d.ts",
      "import": "./dist/global-install.es.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:watch": "npm-run-all2 -s build -p type-check watch:js watch:types",
    "watch:js": "vite build --watch",
    "watch:types": "vue-tsc --declaration --emitDeclarationOnly --watch",
    "build": "npm-run-all2 -s build:js",
    "build:js": "vite build",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "type-check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-alpha.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/language-core": "^3.0.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "catalog:",
    "eslint-plugin-vue": "~10.3.0",
    "histoire": "1.0.0-alpha.3",
    "neostandard": "^0.12.2",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.92.0",
    "typescript": "~5.8.0",
    "vite": "^7.1.5",
    "vue-tsc": "^3.0.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "postcss-prefix-selector": "^2.1.1",
    "tailwindcss": "^4.1.13",
    "vite-plugin-dts": "^4.5.4"
  }
}
