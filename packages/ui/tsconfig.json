{
  "extends": [
    "@tsconfig/node22/tsconfig.json",
    "@vue/tsconfig/tsconfig.dom.json"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": false
  },
  "include": ["**/*.d.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "**/*.story.vue"]
}
